# ── Database ──────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/freight_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=freight_db
DB_USER=user
DB_PASSWORD=password

# ── FastAPI Backend ───────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=your-secret-key-change-this
ENVIRONMENT=development

# ── Streamlit Frontend ────────────────────────────
BACKEND_URL=http://localhost:8000

# ── Data Sources ─────────────────────────────────
# Yahoo Finance proxy (free, no API key needed)
USE_YAHOO_PROXY=true

# Baltic Exchange (paid — leave empty during development)
BALTIC_API_KEY=

# ── Model Settings ───────────────────────────────
MODEL_ARTIFACTS_DIR=./models/artifacts
OPTUNA_N_TRIALS=50
FORECAST_HORIZON_DAYS=30

# ── Logging ──────────────────────────────────────
LOG_LEVEL=INFO
